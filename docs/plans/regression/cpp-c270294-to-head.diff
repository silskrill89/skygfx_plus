+bool
+SaveRawGeomStates(DWORD *out)
+{
+	IDirect3DDevice9 *dev = d3d9device;
+	if(!dev)
+		return false;
+	for(int i = 0; i < RAW_GEOM_STATE_COUNT; i++)
+		dev->GetRenderState(s_rawGeomStateIds[i], &out[i]);
+	return true;
+}
 
