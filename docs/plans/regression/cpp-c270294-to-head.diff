+	// in use until then.
+	if(Scene.camera && RwCameraGetRaster(Scene.camera)){
+		RenderIBLBuffer();
+	}else if(dbglog_throttle("ibl_nocam")){
+		dbglog("RenderIBL: skip, camera not ready (frame %u)", curFrame);
+	}
