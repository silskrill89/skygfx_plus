+		dbglog("[PBR-Ambient] final=(%.3f,%.3f,%.3f) floor=%.3f raw=(%.3f,%.3f,%.3f)",
+			out.red, out.green, out.blue,
+			config ? config->pbrAmbientFloor : 0.0f,
+			s_tcAmbient.red, s_tcAmbient.green, s_tcAmbient.blue);
